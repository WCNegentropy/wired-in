# ── Wired-In Environment Configuration ──────────────────
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wiredin

# Redis
REDIS_URL=redis://localhost:6379

# ── Platform API Keys (user-provided) ───────────────────
# Reddit OAuth2
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wiredin/0.1.0

# YouTube Data API v3
YOUTUBE_API_KEY=

# X/Twitter API v2 (Bearer Token)
X_BEARER_TOKEN=

# NewsAPI.org
NEWSAPI_KEY=

# ── Service Ports ────────────────────────────────────────
GATEWAY_PORT=8080
AGGREGATOR_PORT=4000
WORKERS_PORT=8000
DASHBOARD_PORT=3000
