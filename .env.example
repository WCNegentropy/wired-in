# ── Wired-In Environment Configuration ──────────────────
# Copy to .env and fill in your values

# ── Infrastructure ─────────────────────────────────────
# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wiredin

# Redis
REDIS_URL=redis://localhost:6379

# ── Security ────────────────────────────────────────────
# JWT Secret (change in production!)
JWT_SECRET=dev-secret-change-me

# AES-256-GCM encryption key for API keys at rest (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# CORS allowed origins (comma-separated, or * for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── OAuth (optional) ───────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Platform API Keys (optional — all have fallbacks) ──
# Reddit OAuth2
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wiredin/0.1.0

# YouTube Data API v3
YOUTUBE_API_KEY=

# X/Twitter API v2 (Bearer Token)
X_BEARER_TOKEN=

# NewsAPI.org
NEWSAPI_KEY=

# ── Service Ports ────────────────────────────────────────
GATEWAY_PORT=8080
AGGREGATOR_PORT=4000
WORKERS_PORT=8000
DASHBOARD_PORT=3000

# ── Aggregator ───────────────────────────────────────────
# Background feed refresh interval in seconds (default: 300 = 5 min)
# REFRESH_INTERVAL_SECS=300
